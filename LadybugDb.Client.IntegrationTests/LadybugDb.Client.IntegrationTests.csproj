<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- QueryResultErrorTests drives one native call directly to pin a precondition of the row reader. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Never packed, so no XML doc sidecar is produced from here; its public test classes are test scaffolding, not shipped API. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.62.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LadybugDb.Client\LadybugDb.Client.csproj" />
    <!--
      Upstream's own native packages carry liblbug (runtimes/<rid>/native); this repository ships
      no binaries of its own. LadybugDB.Native is the meta package for every RID, which is what a
      test project that runs on both Linux and Windows CI needs. Its version is the engine version.
    -->
    <PackageReference Include="LadybugDB.Native" Version="0.19.1" />
    <!--
      Not used for its API - referenced so MSBuild builds it and copies its output (and native
      dependencies) next to this project's own, giving TransactionDisposalOrderingTests a
      reliable AppContext.BaseDirectory-relative path to launch it from as a subprocess. See that
      class for why a subprocess, not an in-process call, is required here.
    -->
    <ProjectReference Include="..\LadybugDb.Client.CrashRepro\LadybugDb.Client.CrashRepro.csproj" />
  </ItemGroup>
</Project>
