<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Never packed; its public benchmark classes are harness scaffolding, not shipped API. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- BenchmarkDotNet needs an optimized build to produce meaningful numbers; it refuses to run a Debug build without a flag. -->
    <Optimize>true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LadybugDb.Client\LadybugDb.Client.csproj" />
    <!--
      Upstream's own native packages carry liblbug (runtimes/<rid>/native); this repository ships
      no binaries of its own. LadybugDB.Native is the meta package for every RID, which is what a
      test project that runs on both Linux and Windows CI needs. Its version is the engine version.
    -->
    <PackageReference Include="LadybugDB.Native" Version="0.19.1" />
  </ItemGroup>
</Project>
