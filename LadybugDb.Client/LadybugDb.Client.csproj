<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageId>LadybugDb.Client</PackageId>
    <Description>.NET client for LadybugDB, an embedded graph database with Cypher. Managed assembly only; add upstream's LadybugDB.Native (or LadybugDB.Native.&lt;rid&gt;) package for the engine binaries.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      Package validation runs at pack time. Without a PackageValidationBaselineVersion it checks
      only that the package is consistent with itself (compatible frameworks and runtimes); the
      baseline check, which fails the pack on an API break against the last published version,
      starts when docs/RELEASING.md's first-publish step adds that property.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!--
      Turns on the trim, single-file and AOT analyzers and stamps the assembly as AOT-compatible.
      The reflective paths (parameter objects, Select<T>) are annotated [RequiresUnreferencedCode]
      and surface as warnings in the consumer's AOT build; everything else is P/Invoke over a
      blittable C API, which needs no runtime marshalling. samples/LadybugDb.Client.AotSample is
      published with PublishAot=true in CI to prove it.
    -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!--
      The engine version whose C header this client's interop was generated from
      (third-party/liblbug.version), embedded so LadybugDatabase can refuse an older engine at open
      time instead of failing with EntryPointNotFoundException on the first call that is missing.
      The binaries themselves come from upstream's LadybugDB.Native packages, whose versions are
      engine versions; consumers pick one at least this new.
    -->
    <AssemblyMetadata Include="LadybugEngineVersion" Value="$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../third-party/liblbug.version').Trim())" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LadybugDb.Client.Tests" />
    <InternalsVisibleTo Include="LadybugDb.Client.IntegrationTests" />
    <InternalsVisibleTo Include="LadybugDb.Client.Benchmarks" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Zero transitive dependencies (verified against the published nuspec) - chosen over
      Singulink.Numerics.BigDecimal specifically because Singulink pulls five transitive
      packages. Backs LadybugValue.AsBigDecimal() and LadybugPreparedStatement's BigDecimal
      bind - the lossless path for DECIMAL, which the engine supports up to 38 significant
      digits, beyond .NET's native decimal (28-29).
    -->
    <PackageReference Include="ExtendedNumerics.BigDecimal" Version="3003.2.0.161" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
    <!-- 128x128 PNG, drawn for this repository (no third-party artwork); PackageIcon names it in Directory.Build.props. -->
    <None Include="icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
  <PropertyGroup>
    <!--
      Static analysis is stricter here than the repo default, and deliberately not applied to the
      test projects. Measured at this level, the shipping library reports zero findings while the
      test projects report 306 - 224 of them CA1707, which fires on the Method_DoesThing naming
      convention every test in this repo uses, and the rest test-only concerns like sealing fixture
      classes. Raising the bar where consumers are affected keeps that signal; raising it everywhere
      would have buried it.
    -->
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>
</Project>
